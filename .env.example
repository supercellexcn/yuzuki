# 后端端口（容器内部，一般不用改）
PORT=3000

# 数据目录（SQLite 数据库 + 封面缓存）
DATA_DIR=./data

# 前端对外端口（浏览器访问的端口）
FRONTEND_PORT=8080

# 令牌签名密钥：务必修改为随机字符串！
# 生成方式：openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-string

# ASMR 源路径（逗号分隔的宿主机绝对路径）
# 每个路径都需要在 docker-compose.yml 里挂载到容器内相同位置。
# 例：ASM_PATHS=D:/temp,E:/Download/soundTemp
# 挂载示例：- "D:/temp:/asmr1:ro"
ASM_PATHS=

# 扫描层级深度（默认 2）
SCAN_DEPTH=2

# DLsite 抓取代理（留空则直连，容器内若无法直连需配置）
# PROXY=http://host.docker.internal:7890
PROXY=
